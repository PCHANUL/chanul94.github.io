      bg.fillStyle(3154713, 0.3).fillCircle(215, -30, 300);
      bg.fillStyle(2366485, 0.5).fillCircle(215, -36, 224);
      bg.fillStyle(4924440, 0.08).fillCircle(388, 184, 158);
      bg.fillStyle(789001, 0.34).fillRect(0, 595, GAME_WIDTH, GAME_HEIGHT - 595);
      bg.lineStyle(1, COLORS.line, 0.075);
      for (let x = 17; x < GAME_WIDTH; x += 31) {
        for (let y = 14; y < GAME_HEIGHT; y += 29) bg.strokeRect(x, y, 1, 1);
      }
      this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 0, 0.08);
    }
    startGame() {
      this.phase = 1;
      this.maxHeat = REFINING_HEAT_SECONDS;
      this.heat = this.maxHeat;
      this.tileId = 1;
      this.busy = false;
      this.targetType = this.injectedType && this.isWeaponUnlocked(this.injectedType) ? this.injectedType : "blade";
      this.forged = null;
      this.resultSaved = false;
      this.guideDialogOpen = false;
      this.stageGuideStage = null;
      this.modalLayer.removeAll(true);
      this.newRefiningGrid();
      this.renderRefining();
    }
    clearStage() {
      if (this.stageLayer) this.stageLayer.destroy(true);
      this.stageLayer = this.add.container(0, 0).setDepth(10);
    }
    text(x, y, content, size = 12, color = COLORS.ash, originX = 0, originY = 0) {
      const renderedSize = Math.max(size, MIN_UI_FONT_SIZE);
      const text = this.add.text(x, y, content, {
        fontFamily: UI_FONT,
        fontSize: `${renderedSize}px`,
        color: `#${color.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION,
        lineSpacing: 5
      }).setOrigin(originX, originY);
      this.stageLayer.add(text);
      return text;
    }
    displayText(x, y, content, size = 20, color = COLORS.bone, originX = 0, originY = 0) {
      const text = this.add.text(x, y, content, {
        fontFamily: DISPLAY_FONT,
        fontSize: `${Math.max(size, MIN_UI_FONT_SIZE)}px`,
        color: `#${color.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION,
        lineSpacing: 5
      }).setOrigin(originX, originY);
      this.stageLayer.add(text);
      return text;
    }
    monoText(x, y, content, size = 12, color = COLORS.ash, originX = 0, originY = 0) {
      const text = this.add.text(x, y, content, {
        fontFamily: MONO_FONT,
        fontSize: `${Math.max(size, MIN_UI_FONT_SIZE)}px`,
        color: `#${color.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION,
        lineSpacing: 5
      }).setOrigin(originX, originY);
      this.stageLayer.add(text);
      return text;
    }
    panel(x, y, width, height, radius = 10, fill = COLORS.panel, alpha = 0.96) {
      const corner = Math.min(radius, 5);
      const graphics = this.add.graphics();
      graphics.fillStyle(0, 0.38).fillRoundedRect(x + 1, y + 7, width, height, corner);
      graphics.fillStyle(fill, alpha).fillRoundedRect(x, y, width, height, corner);
      graphics.lineStyle(1, COLORS.line, 0.92).strokeRoundedRect(x + 0.5, y + 0.5, width - 1, height - 1, corner);
      graphics.lineStyle(1, COLORS.bone, 0.035).lineBetween(x + corner, y + 1.5, x + width - corner, y + 1.5);
      this.stageLayer.add(graphics);
      return graphics;
    }
    button(x, y, width, height, title, subtitle, callback, accent = false) {
      const group = this.add.container(x, y);
      const shadow = this.add.rectangle(1, 5, width, height, 0, 0.42);
      const bg = this.add.rectangle(0, 0, width, height, accent ? COLORS.emberDark : COLORS.panelHi, 1).setStrokeStyle(1, accent ? COLORS.ember : COLORS.line, 0.95).setInteractive({ useHandCursor: true });
      const titleText = this.add.text(0, subtitle ? -7 : 0, title, {
        fontFamily: UI_FONT,
        fontSize: `${subtitle ? 13 : 17}px`,
        color: `#${COLORS.bone.toString(16)}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0.5);
      group.add([shadow, bg, titleText]);
      if (subtitle) {
        group.add(
          this.add.text(0, 10, subtitle, {
            fontFamily: UI_FONT,
            fontSize: "11px",
            color: `#${COLORS.ash.toString(16)}`,
            resolution: TEXT_RESOLUTION
          }).setOrigin(0.5)
        );
      }
      bg.on("pointerover", () => bg.setFillStyle(accent ? COLORS.ember : 3812899));
      bg.on("pointerout", () => bg.setFillStyle(accent ? COLORS.emberDark : COLORS.panelHi));
      bg.on("pointerdown", () => {
        group.setScale(0.97);
        this.tone(accent ? 220 : 410, 0.04, "square", 0.025);
        callback();
      });
      bg.on("pointerup", () => group.setScale(1));
      bg.on("pointerout", () => group.setScale(1));
      this.stageLayer.add(group);
      return { group, bg };
    }
    drawChrome(active) {
      const navigation = this.add.graphics();
      navigation.fillStyle(1840915, 0.985).fillRect(0, 0, 430, TOP_NAV_BOTTOM);
      navigation.fillStyle(COLORS.line, 0.72).fillRect(0, 0, 430, 4);
      navigation.fillStyle(COLORS.gold, 0.88).fillRect(18, 19, 4, 32);
      navigation.lineStyle(1, COLORS.line, 0.58).lineBetween(18, 131.5, 412, 131.5);
      navigation.lineStyle(1, COLORS.line, 0.9).lineBetween(0, TOP_NAV_BOTTOM - 0.5, 430, TOP_NAV_BOTTOM - 0.5);
      navigation.lineStyle(1, COLORS.bone, 0.035).lineBetween(18, 60.5, 412, 60.5);
      this.stageLayer.add(navigation);
      this.displayText(30, 14, "제작소", 25, COLORS.bone);
      this.monoText(30, 45, "FORGE WORKSHOP", 8, COLORS.muted);
      this.text(400, 18, `${["정련", "벼리기", "담금질"][active - 1]} 중`, 12, COLORS.gold, 1, 0).setStyle({ fontStyle: "bold" });
      this.text(400, 43, "현재 공정", 8, COLORS.muted, 1, 0);
      this.drawStageProgress(active);
      this.drawStageGuideBadge(active);
    }
    stageGuideContent(active) {
      return [
        {
          stage: "정련",
          kicker: "REFINING GUIDE",
          icons: ["material", "material", "ingot"],
          title: "같은 재료를 겹쳐 잉곳을 만드세요",
          process: "재료 + 재료  →  잉곳",
          detail: "6 × 6 정련판에서 같은 크기와 단련도의 재료를 겹칩니다. 보드는 스와이프하거나 방향키로 이동합니다.",
          controls: "SWIPE  /  ← ↑ ↓ →",
          accent: COLORS.ember
        },
        {
          stage: "벼리기",
          kicker: "FORGING GUIDE",
          icons: ["ingot", "blade"],
          title: "자루부터 칼끝 방향으로 잉곳을 쌓으세요",
          process: "자루  →  칼끝",
          detail: "NEXT 대기열의 잉곳을 위에서부터 차례로 배치합니다. 재료의 위치와 무기 형태가 최종 성능을 결정합니다.",
          controls: "MOVE  /  HOLD  /  DROP",
          accent: COLORS.gold
        },
        {
          stage: "담금질",
          kicker: "QUENCHING GUIDE",
          icons: ["flame", "drop"],
          title: "적정 온도에서 손을 떼세요",
          process: "가열  →  적정 구간  →  놓기",
          detail: "밝은 주황색 적정 구간에서 손을 뗍니다. 과열되면 성능 상승이 둔해지고 파손 위험이 빠르게 커집니다.",
          controls: "HOLD  /  RELEASE",
          accent: COLORS.sky
        }
      ][active - 1];
    }
    // 아이콘 중심 미니멀 배지는 한 줄 높이를 유지하고, 클릭하면 별도의 설명창을
    // 띄워 공정·세부 규칙·조작법을 읽을 수 있게 한다.
    drawStageGuideBadge(active) {
      if (this.stageGuideStage !== active) {
        this.stageGuideStage = active;
      }
      const x = 18;
      const y = 137;
      const width = 394;
      const height = 30;
      const content = this.stageGuideContent(active);
      const accent = content.accent;
      const bar = this.add.graphics();
      bar.fillStyle(986122, 0.72).fillRoundedRect(x, y, width, height, 4);
      bar.lineStyle(1, COLORS.line, 0.62).strokeRoundedRect(x + 0.5, y + 0.5, width - 1, height - 1, 4);
      this.stageLayer.add(bar);
      const centerY = y + height / 2;
      this.drawGuideIconChain(bar, content.icons, x + width / 2, centerY, accent);
      const helpX = x + width - 16;
      bar.lineStyle(1, 16777215, 0.9).strokeCircle(helpX, centerY, 8);
      this.text(helpX, centerY, "?", 10, 16777215, 0.5, 0.5).setStyle({
        fontFamily: MONO_FONT,
        fontStyle: "bold"
      });
      const hitArea = this.add.rectangle(x + width / 2, centerY, width, height, 16777215, 1e-3).setInteractive({ useHandCursor: true });
      hitArea.on("pointerdown", () => this.openStageGuideDialog(active));
      this.stageLayer.add(hitArea);
    }
    openStageGuideDialog(active) {
      if (this.guideDialogOpen || ![1, 2, 3].includes(active)) return;
      const content = this.stageGuideContent(active);
      this.guideDialogOpen = true;
      this.modalLayer.removeAll(true);
      this.tone(460, 0.045, "square", 0.022);
      const shade = this.add.rectangle(GAME_WIDTH / 2, GAME_HEIGHT / 2, GAME_WIDTH, GAME_HEIGHT, 722951, 0.78).setInteractive();
      const group = this.add.container(0, this.reduceMotion ? 0 : 10);
      const shadow = this.add.rectangle(218, 421, 360, 330, 0, 0.58);
      const panel = this.add.graphics();
      panel.fillStyle(COLORS.panel, 1).fillRoundedRect(35, 250, 360, 330, 5);
      panel.lineStyle(1, COLORS.line, 1).strokeRoundedRect(35.5, 250.5, 359, 329, 5);
      panel.fillStyle(content.accent, 0.96).fillRect(36, 251, 358, 5);
      panel.lineStyle(1, COLORS.line, 0.58).lineBetween(55, 321.5, 375, 321.5);
      const blocker = this.add.rectangle(215, 415, 360, 330, 16777215, 1e-3).setInteractive();
      const kicker = this.add.text(55, 270, content.kicker, {
        fontFamily: MONO_FONT,
        fontSize: "8px",
        color: `#${content.accent.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0, 0);
      const title = this.add.text(55, 292, `${content.stage} 가이드`, {
        fontFamily: DISPLAY_FONT,
        fontSize: "23px",
        color: `#${COLORS.bone.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0, 0);
      const processPlate = this.add.rectangle(215, 362, 320, 58, 1512208, 1).setStrokeStyle(1, content.accent, 0.56);
      const process2 = this.add.text(215, 362, content.process, {
        fontFamily: UI_FONT,
        fontSize: "14px",
        fontStyle: "bold",
        color: `#${COLORS.bone.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0.5);
      const summary = this.add.text(55, 405, content.title, {
        fontFamily: UI_FONT,
        fontSize: "11px",
        fontStyle: "bold",
        color: `#${COLORS.gold.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0, 0);
      const detail = this.add.text(55, 430, content.detail, {
        fontFamily: UI_FONT,
        fontSize: "10px",
        color: `#${COLORS.ash.toString(16).padStart(6, "0")}`,
        wordWrap: { width: 320 },
        lineSpacing: 5,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0, 0);
      const controlPlate = this.add.rectangle(215, 500, 320, 38, 2103829, 1).setStrokeStyle(1, COLORS.line, 0.8);
      const controlLabel = this.add.text(215, 500, content.controls, {
        fontFamily: MONO_FONT,
        fontSize: "9px",
        color: `#${content.accent.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0.5);
      const closeButton = this.add.rectangle(215, 550, 320, 42, COLORS.emberDark, 1).setStrokeStyle(1, COLORS.ember, 0.9).setInteractive({ useHandCursor: true });
      const closeLabel = this.add.text(215, 550, "닫기", {
        fontFamily: UI_FONT,
        fontSize: "12px",
        fontStyle: "bold",
        color: `#${COLORS.bone.toString(16).padStart(6, "0")}`,
        resolution: TEXT_RESOLUTION
      }).setOrigin(0.5);
      group.add([
        shadow,
        panel,
        blocker,
        kicker,
        title,
        processPlate,
        process2,
        summary,
        detail,
        controlPlate,
        controlLabel,
        closeButton,
        closeLabel
      ]);
      this.modalLayer.add([shade, group]);
      shade.on("pointerdown", () => this.closeStageGuideDialog());
      closeButton.on("pointerover", () => closeButton.setStrokeStyle(2, COLORS.gold, 1));
      closeButton.on("pointerout", () => closeButton.setStrokeStyle(1, COLORS.ember, 0.9));
      closeButton.on("pointerdown", () => this.closeStageGuideDialog());
      if (!this.reduceMotion) {
        group.setAlpha(0);
        this.tweens.add({ targets: group, y: 0, alpha: 1, duration: 240, ease: "Back.out" });
      }
    }
    closeStageGuideDialog() {
      if (!this.guideDialogOpen) return;
      this.guideDialogOpen = false;
      this.modalLayer.removeAll(true);
      this.tone(350, 0.035, "square", 0.018);
    }
    drawGuideIconChain(graphics, icons, centerX, centerY, accent) {
      const size = 13;
      const gap = 24;
      const totalWidth = (icons.length - 1) * gap;
      let cursorX = centerX - totalWidth / 2;
      icons.forEach((kind, index) => {
        this.drawGuideIcon(graphics, kind, cursorX, centerY, size, accent);
        if (index < icons.length - 1) {
          const glyph = kind === "material" && icons[index + 1] === "material" ? "+" : "→";
          this.text(cursorX + gap / 2, centerY, glyph, 10, COLORS.muted, 0.5, 0.5);
        }
        cursorX += gap;
      });
    }
    // 이 게임의 기존 시각 언어(재료 타일 = 어두운 사각형, 잉곳 = 금테)를 그대로
    // 재사용해서, 새로 발명한 아이콘이 아니라 이미 익숙한 모양으로 공정을 읽게 한다.
    drawGuideIcon(graphics, kind, x, y, size, accent) {
      const half = size / 2;
      switch (kind) {
        case "material":
          graphics.fillStyle(COLORS.line, 0.92).fillRoundedRect(x - half, y - half, size, size, 2);
          graphics.lineStyle(1, 198153, 0.7).strokeRoundedRect(x - half + 0.5, y - half + 0.5, size - 1, size - 1, 2);
          break;
        case "ingot":
          graphics.fillStyle(accent, 0.24).fillRoundedRect(x - half, y - half, size, size, 2);
          graphics.lineStyle(1.4, COLORS.gold, 0.95).strokeRoundedRect(x - half + 0.5, y - half + 0.5, size - 1, size - 1, 2);
          break;
        case "blade":
          graphics.fillStyle(COLORS.line, 0.9).fillRect(x - 1, y + size * 0.1, 2, size * 0.5);
          graphics.fillStyle(COLORS.sky, 0.88).fillTriangle(x - size * 0.4, y + size * 0.15, x + size * 0.4, y + size * 0.15, x, y - half);
          break;
        case "flame":
          graphics.fillStyle(COLORS.ember, 0.92).fillCircle(x, y + size * 0.22, size * 0.32);
          graphics.fillStyle(COLORS.ember, 0.92).fillTriangle(x - size * 0.25, y + size * 0.05, x + size * 0.25, y + size * 0.05, x, y - half);
          break;
        case "drop":
          graphics.fillStyle(COLORS.sky, 0.9).fillCircle(x, y + size * 0.15, size * 0.3);
          graphics.fillStyle(COLORS.sky, 0.9).fillTriangle(x - size * 0.2, y, x + size * 0.2, y, x, y - half);
          break;
        default:
          break;
      }
    }
    drawStageProgress(active) {
      const requested = new URLSearchParams(window.location.search).get("progress") || "rail";
      const variant = { "1": "plate", "2": "rail", "3": "stamp" }[requested] || requested;
      const phaseChanged = this.lastChromeStage !== active;
      if (variant === "rail") this.drawStageProgressRail(active, phaseChanged);
      else if (variant === "stamp") this.drawStageProgressStamp(active, phaseChanged);
      else this.drawStageProgressPlate(active, phaseChanged);
      this.lastChromeStage = active;
    }
    drawStageProgressPlate(active, phaseChanged) {
      const steps = ["정련", "벼리기", "담금질"];
      const startX = 18;
      const totalWidth = 394;
      const gap = 8;
      const plateWidth = (totalWidth - gap * 2) / steps.length;
      const plateHeight = 42;
      const plateY = 94;
      const progressY = 122;
      const rail = this.add.graphics();
      rail.fillStyle(COLORS.lineSoft, 1).fillRect(startX, progressY, totalWidth, 3);
      const segmentWidth = totalWidth / steps.length;
      const completedWidth = segmentWidth * Math.max(0, active - 1);
      if (completedWidth > 0) rail.fillStyle(COLORS.mint, 0.92).fillRect(startX, progressY, completedWidth, 3);
      rail.fillStyle(COLORS.gold, 1).fillRect(startX + completedWidth, progressY, segmentWidth, 3);
      for (let index = 1; index < steps.length; index += 1) {
        rail.fillStyle(COLORS.bg, 1).fillRect(startX + segmentWidth * index - 1, progressY - 1, 2, 5);
      }
      this.stageLayer.add(rail);
      steps.forEach((label, index) => {
        const number = index + 1;
        const completed = number < active;
        const current = number === active;
        const accentColor = current ? COLORS.gold : completed ? COLORS.mint : COLORS.line;
        const fillColor = current ? 3352863 : completed ? 2435619 : 1512465;
        const centerX = startX + plateWidth / 2 + index * (plateWidth + gap);
        const group = this.add.container(centerX, plateY);
        const plate = this.add.graphics();
        plate.fillStyle(0, 0.34).fillRoundedRect(-plateWidth / 2 + 1, -plateHeight / 2 + 4, plateWidth, plateHeight, 4);
        plate.fillStyle(fillColor, 1).fillRoundedRect(-plateWidth / 2, -plateHeight / 2, plateWidth, plateHeight, 4);
        plate.lineStyle(current ? 1.5 : 1, accentColor, current ? 1 : completed ? 0.75 : 0.58).strokeRoundedRect(-plateWidth / 2 + 0.5, -plateHeight / 2 + 0.5, plateWidth - 1, plateHeight - 1, 4);
        plate.fillStyle(accentColor, current || completed ? 1 : 0.22).fillRect(-plateWidth / 2 + 1, -plateHeight / 2 + 1, plateWidth - 2, 3);
        plate.fillStyle(COLORS.bg, 0.9).fillRect(-plateWidth / 2 + 10, -12, 28, 24);
        plate.lineStyle(1, accentColor, current || completed ? 0.8 : 0.42).strokeRect(-plateWidth / 2 + 10.5, -11.5, 27, 23);
        const numberText = this.add.text(-plateWidth / 2 + 24, 0, `0${number}`, {
          fontFamily: MONO_FONT,
          fontSize: "9px",
          fontStyle: "bold",
          color: `#${accentColor.toString(16).padStart(6, "0")}`,
          resolution: TEXT_RESOLUTION
        }).setOrigin(0.5);
        const labelText = this.add.text(8, 0, label, {
          fontFamily: UI_FONT,
          fontSize: "11px",
          fontStyle: current ? "bold" : "normal",
          color: `#${(current ? COLORS.bone : completed ? COLORS.mint : COLORS.muted).toString(16).padStart(6, "0")}`,
          resolution: TEXT_RESOLUTION
        }).setOrigin(0.5);
        const stateText = this.add.text(plateWidth / 2 - 9, 0, completed ? "✓" : current ? "●" : "", {
          fontFamily: MONO_FONT,
          fontSize: "8px",
          color: `#${accentColor.toString(16).padStart(6, "0")}`,
          resolution: TEXT_RESOLUTION
        }).setOrigin(1, 0.5);
        group.add([plate, numberText, labelText, stateText]);
        this.stageLayer.add(group);
        if (current) this.animateStageMarker(group, plateY, phaseChanged);
      });
    }
    drawStageProgressRail(active, phaseChanged) {
      const steps = ["정련", "벼리기", "담금질"];
      const stepXs = [56, 215, 374];
      const railY = 91;
      const graphics = this.add.graphics();
      graphics.fillStyle(0, 0.48).fillRect(stepXs[0], railY - 2, stepXs[2] - stepXs[0], 8);
      graphics.fillStyle(COLORS.lineSoft, 1).fillRect(stepXs[0], railY - 4, stepXs[2] - stepXs[0], 6);
      graphics.fillStyle(COLORS.bone, 0.05).fillRect(stepXs[0], railY - 3, stepXs[2] - stepXs[0], 1);
      if (active > 2) {
        graphics.fillStyle(COLORS.mint, 0.9).fillRect(stepXs[0], railY - 4, stepXs[active - 2] - stepXs[0], 6);
      }
      if (active > 1) {
        graphics.fillStyle(COLORS.gold, 1).fillRect(stepXs[active - 2], railY - 4, stepXs[active - 1] - stepXs[active - 2], 6);
      }
      this.stageLayer.add(graphics);
      steps.forEach((label, index) => {
        const number = index + 1;
        const completed = number < active;
        const current = number === active;
        const accentColor = current ? COLORS.gold : completed ? COLORS.mint : COLORS.line;
        const group = this.add.container(stepXs[index], railY);
        const diamond = this.add.graphics();
        const size = 14;
        const fill = current ? 3352863 : completed ? 2502950 : COLORS.bg;
        if (current) {
          diamond.fillStyle(COLORS.gold, 0.08);
          diamond.beginPath().moveTo(0, -19).lineTo(19, 0).lineTo(0, 19).lineTo(-19, 0).closePath().fillPath();
        }
        diamond.fillStyle(0, 0.52);
        diamond.beginPath().moveTo(2, -size + 3).lineTo(size + 2, 3).lineTo(2, size + 3).lineTo(-size + 2, 3).closePath().fillPath();
        diamond.fillStyle(fill, 1);
        diamond.beginPath().moveTo(0, -size).lineTo(size, 0).lineTo(0, size).lineTo(-size, 0).closePath().fillPath();
        diamond.lineStyle(current ? 2 : 1, accentColor, current ? 1 : completed ? 0.82 : 0.62);
        diamond.beginPath().moveTo(0, -size).lineTo(size, 0).lineTo(0, size).lineTo(-size, 0).closePath().strokePath();
        diamond.lineStyle(1, accentColor, current ? 0.5 : 0.24);
        diamond.beginPath().moveTo(0, -size + 4).lineTo(size - 4, 0).lineTo(0, size - 4).lineTo(-size + 4, 0).closePath().strokePath();
        diamond.fillStyle(accentColor, current ? 1 : completed ? 0.72 : 0.3);
        diamond.fillRect(-1.5, -size - 2, 3, 3);
        diamond.fillRect(-1.5, size - 1, 3, 3);
        this.drawStageProgressIcon(diamond, index, accentColor, current ? 1 : completed ? 0.88 : 0.52);
