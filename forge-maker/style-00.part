/* node_modules/@fontsource/black-han-sans/korean.css */
@font-face {
  font-family: "Black Han Sans";
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url(data:font/woff2;base64,) format("woff2"), url(data:font/woff;base64,) format("woff");
}

