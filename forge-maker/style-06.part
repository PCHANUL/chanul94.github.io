) format("woff");
}

/* src/style.css */
:root {
  color-scheme: dark;
  --bg-void: #161210;
  --bg-card: #251e17;
  --ink: #e9ddc6;
  --ink-dim: #a2917a;
  --line-metal: #5c5142;
  --grade-common: #6b6355;
  --grade-mid: #8f9aa3;
  --grade-high: #c9963f;
  --grade-unique: #cf5b2e;
  --attr-frost: #5f93b0;
  --attr-fire: #9c3f26;
  --attr-holy: #c7a542;
  --attr-none: #7d7568;
  --give: #7a9b76;
  --pass: #9c3f26;
  --stamp-ink: #8c3a2c;
  font-family:
    "Noto Sans KR",
    "Apple SD Gothic Neo",
    "Malgun Gothic",
    system-ui,
    sans-serif;
  background: var(--bg-void);
}
* {
  box-sizing: border-box;
}
html,
body,
#game,
#forge-root {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse 82% 54% at 50% -10%,
      #2d2118 0%,
      #241c15 30%,
      var(--bg-void) 55%),
    var(--bg-void);
  overscroll-behavior: none;
  touch-action: none;
}
canvas {
  display: block;
  image-rendering: auto;
  outline: none;
}
@media (min-width: 700px) {
  #game::before,
  #game::after,
  #forge-root::before,
  #forge-root::after {
    content: "";
    position: fixed;
    top: 0;
    bottom: 0;
    width: 1px;
    background:
      linear-gradient(
        transparent,
        rgba(92, 81, 66, 0.42),
        transparent);
    pointer-events: none;
  }
  #game::before,
  #forge-root::before {
    left: calc(50% - 217px);
  }
  #game::after,
  #forge-root::after {
    right: calc(50% - 217px);
  }
}

/* phaser-standalone/standalone.css */
:root {
  color-scheme: dark;
}
body::before {
  position: fixed;
  z-index: 20;
  inset: 0;
  content: "";
  pointer-events: none;
  opacity: 0.16;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.74' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E");
  mix-blend-mode: soft-light;
}
#forge-root {
  position: relative;
  isolation: isolate;
}
#forge-root canvas {
  position: relative;
  z-index: 1;
}
.boot-screen {
  position: absolute;
  z-index: 40;
  inset: 0;
  display: grid;
  place-items: center;
  background:
    radial-gradient(
      circle at 50% 34%,
      rgba(207, 91, 46, 0.12),
      transparent 20%),
    radial-gradient(
      ellipse 82% 54% at 50% -10%,
      #2d2118,
      #241c15 30%,
      #161210 55%);
  opacity: 1;
  transition: opacity 420ms ease, visibility 420ms;
}
.boot-screen.is-ready {
  visibility: hidden;
  opacity: 0;
}
.boot-mark {
  display: grid;
  width: min(72vw, 270px);
  justify-items: center;
  color: #e9ddc6;
  text-align: center;
}
.boot-emblem {
  position: relative;
  display: grid;
  width: 58px;
  height: 58px;
  margin-bottom: 22px;
  place-items: center;
  border: 1px solid #5c5142;
  border-radius: 5px;
  color: #c9963f;
  font-family: "Black Han Sans", sans-serif;
  font-size: 27px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55), inset 0 0 18px rgba(201, 150, 63, 0.08);
  transform: rotate(45deg);
}
.boot-emblem span {
  transform: rotate(-45deg);
}
.boot-title {
  margin: 0 0 7px;
  font-family: "Black Han Sans", sans-serif;
  font-size: 22px;
  font-weight: 400;
  letter-spacing: 0.025em;
}
.boot-copy {
  min-height: 34px;
  margin: 0;
  color: #a2917a;
  font-family: "Noto Sans KR", sans-serif;
  font-size: 11px;
  line-height: 1.55;
}
.boot-line {
  position: relative;
  width: 100%;
  height: 2px;
  margin-top: 22px;
  overflow: hidden;
  background: #30271e;
}
.boot-action {
  min-width: 152px;
  min-height: 44px;
  margin-top: 20px;
  border: 1px solid #c9963f;
  border-radius: 5px;
  color: #e9ddc6;
  font-family: "Noto Sans KR", sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  background: linear-gradient(#3a281c, #281b15);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.42), inset 0 1px rgba(255, 255, 255, 0.05);
  cursor: pointer;
}
.boot-action:active {
  transform: translateY(1px);
}
.boot-action:disabled {
  opacity: 0.42;
  cursor: wait;
}
.boot-line::after {
  position: absolute;
  inset: 0;
  content: "";
  background:
    linear-gradient(
      90deg,
      transparent,
      #cf5b2e,
      #c9963f,
      transparent);
  transform: translateX(-100%);
  animation: temper-line 1.15s cubic-bezier(0.4, 0.15, 0.2, 1) infinite;
}
.boot-screen.has-error .boot-emblem {
  color: #9c3f26;
}
.boot-screen.has-error .boot-line::after {
  background: #9c3f26;
  animation: none;
  transform: none;
}
@keyframes temper-line {
  to {
    transform: translateX(100%);
  }
}
@media (prefers-reduced-motion: reduce) {
  .boot-line::after {
    animation: none;
    transform: none;
  }
  .boot-screen {
    transition-duration: 1ms;
  }
  .boot-action:active {
    transform: none;
  }
}
