      this.quenchBreakText.setText(`${Math.round(stats.brittleness)}%`).setColor(`#${breakColor.toString(16).padStart(6, "0")}`);
      this.quenchBladeStateText.setText(state.label).setColor(`#${state.color.toString(16).padStart(6, "0")}`);
