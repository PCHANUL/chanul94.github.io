    quenchBladeState(stats) {
      if (this.quenchHeat <= 0) return { label: "대기", color: COLORS.muted };
      if (this.quenchHeat < 40) return { label: "가열", color: COLORS.ember };
      if (this.quenchHeat <= 75) return { label: "경화", color: COLORS.mint };
      if (this.quenchHeat < this.overheatLine && stats.brittleness < 55) return { label: "불안정", color: COLORS.gold };
      return { label: "균열 위험", color: COLORS.red };
